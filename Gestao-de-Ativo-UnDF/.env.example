# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-replace-this-with-a-real-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ─── Supabase ────────────────────────────────────────────────────────────────
# Copie os valores reais do Connect Dialog do Supabase Dashboard.
# NUNCA commite a SECRET KEY no repositório.
#
# DATABASE_URL: vá em Supabase Dashboard → Settings → Database → Connection String
# Escolha "Transaction mode" (porta 6543) para produção ou "Session mode" (porta 5432) para dev.
DATABASE_URL=postgres://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/<db-name>

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key-here
SUPABASE_SECRET_KEY=your-service-role-key-here
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Bucket do Supabase Storage para imagens dos ativos
SUPABASE_STORAGE_BUCKET=ativos-imagens

# ─── JWT Settings ─────────────────────────────────────────────────────────────
JWT_SECRET_KEY=django-insecure-replace-this-with-a-real-secret-key-in-production
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
